# API-Football (API-Sports direct) — powers the "Find match" auto-fill in Log Event.
# Get your key: https://dashboard.api-football.com  (sent as x-apisports-key)
# Local dev: copy this file to `.env.local` and paste your key.
# Production: add FOOTBALL_API_KEY in Vercel → Project → Settings → Environment Variables.
# NOTE: server-only — do NOT prefix with NEXT_PUBLIC_, or the key would leak to the browser.
FOOTBALL_API_KEY=
